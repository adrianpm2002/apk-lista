{
  "name": "apk-lista-clean",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:production": "cross-env NODE_ENV=production eas build --platform android --profile production",
    "build:production-apk": "cross-env NODE_ENV=production eas build --platform android --profile production-apk",
    "validate:security": "node scripts/validate-build.js",
    "prebuild:production": "npm run validate:security",
    "clean": "expo r -c",
    "security:check": "npm audit && npm run validate:security"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-picker/picker": "2.9.0",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "@supabase/supabase-js": "^2.56.1",
    "@tanstack/react-query": "^5.90.3",
    "@types/react": "~18.3.12",
    "cross-env": "^10.0.0",
    "csstype": "^3.1.3",
    "date-fns": "^4.1.0",
    "expo": "~52.0.14",
    "expo-background-fetch": "~13.0.6",
    "expo-notifications": "^0.29.14",
    "expo-print": "~14.0.3",
    "expo-sharing": "~13.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.0",
    "expo-task-manager": "~12.0.6",
    "formik": "^2.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "react-test-renderer": "^18.3.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-chart-kit",
          "cross-env",
          "csstype"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
