{
  "expo": {
    "name": "Cloud",
    "slug": "apk-lista-clean-adrian-new",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "apk-lista-clean",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adrianpm.apklistaclean"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.adrianpm.apklistaclean",
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "ff8415f9-a7cd-425b-a1aa-f6e2b418633b"
      }
    },
    "plugins": [
      "expo-splash-screen",
      "expo-notifications",
      [
        "expo-background-fetch",
        {
          "backgroundModes": ["background-fetch"]
        }
      ]
    ],
    "owner": "lazaroadrian0803"
  }
}
